# Cadena de conexión de MongoDB Atlas.
# Copiar este archivo a .env y reemplazar por la URI real.
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tiendaHardware?retryWrites=true&w=majority

# Opcionales (los valores mostrados son los predeterminados)
# MONGODB_MAX_POOL_SIZE=5
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_SOCKET_TIMEOUT_MS=45000
# MONGODB_MAX_IDLE_TIME_MS=60000
# QUERY_TIMEOUT_MS=5000
# CACHE_SECONDS=60
# STALE_SECONDS=300
# PORT=3000
